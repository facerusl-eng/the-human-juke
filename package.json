    "loadtest:audience": "node scripts/loadtest-audience-join.mjs",
    "mixer:preset:backing": "node scripts/apply-backing-preset.mjs",
    "mixer:mute": "node scripts/mixer-mute-hotkeys.mjs",
    "ci:verify": "npm run lint && npm run build"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@supabase/supabase-js": "^2.104.1",
    "@vercel/analytics": "^2.0.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "heic2any": "^0.0.4",
    "lucide-react": "^1.14.0",
    "node-osc": "^11.4.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "react-window": "^2.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.4",
