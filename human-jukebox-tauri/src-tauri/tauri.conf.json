{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Human Jukebox",
  "version": "0.1.0",
  "identifier": "org.thehumanjukebox.desktop",
  "build": {
    "beforeDevCommand": "node scripts/ensure-dev-server.mjs",
    "beforeBuildCommand": "npm run build:web",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Human Jukebox",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
